# Copy to .env before running anything: cp .env.example .env
# .env is git-ignored. These are placeholders: never commit real secrets.

# --- PostgreSQL (the db container creates this user and database on first start) ---
# Database user.
POSTGRES_USER=teslapool
# Password for that user. Letters and digits only: it is also placed inside DATABASE_URL.
POSTGRES_PASSWORD=changeme
# Database name.
POSTGRES_DB=teslapool
# Port for the db container on your machine. If another Postgres already listens on
# 5432, use e.g. 5433 here and change the port in DATABASE_URL below to match.
DB_PORT=5432

# --- API ---
# Connection string for running the API on your machine (npm run dev:api).
# In Docker, docker-compose.yml builds the same URL with host "db" instead of localhost.
DATABASE_URL=postgres://teslapool:changeme@localhost:5432/teslapool
# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string
# How long a login token stays valid, e.g. 1h, 12h, 7d.
JWT_EXPIRES_IN=1h
# The only browser origin allowed to call the API (CORS): the Next.js web app.
WEB_ORIGIN=http://localhost:3000

# --- Tests ---
# Database for the e2e tests (npm test), on the same Postgres as DATABASE_URL.
# It is created automatically and emptied before tests, so its name must end in _test.
TEST_DATABASE_URL=postgres://teslapool:changeme@localhost:5432/teslapool_test
